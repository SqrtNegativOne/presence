# Presence backend environment variables
# Copy to backend/.env and adjust as needed. Do NOT commit real secrets.

# PostgreSQL connection string. Render/Neon provide this directly.
# The local fallback used by run.ps1 is on port 5433.
DATABASE_URL=postgresql://presence:presence@localhost:5432/presence

# When false, server-side InsightFace endpoints (/api/students/enroll and
# /api/attendance/process) return 503 and the heavy ML stack is never imported.
# Local (browser) mode keeps working. Default: true.
CLOUD_MODE_ENABLED=true

# Comma-separated CORS allow-list of frontend origins.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Port to bind. Render injects this; defaults to 8000.
PORT=8000
