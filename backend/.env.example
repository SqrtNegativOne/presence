# Copy this file to backend/.env (or set the variables in your shell) before running.

# Random ~64-char string. All issued session tokens are invalidated when this changes.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
PRESENCE_JWT_SECRET=

# OAuth client ID from https://console.cloud.google.com/apis/credentials
# Must match VITE_GOOGLE_CLIENT_ID on the frontend.
# If empty, the backend will accept Google tokens without verifying the audience
# claim — fine for local development, NOT for production.
PRESENCE_GOOGLE_CLIENT_ID=

# Set to 0 to skip the demo user / demo students seeder on startup.
PRESENCE_SEED_DEMO=1
